########################################
## <summary>
##	Allow role to run Trivalent from the given domain.
## </summary>
## <param name="domain_prefix">
##	<summary>
##	The prefix of the domain (e.g., user is the prefix for user_t).
##	</summary>
## </param>
## <param name="role">
##	<summary>
##	Role (or role attribute) allowed access.
##	</summary>
## </param>
## <param name="domain">
##	<summary>
##	User domain for the role.
##	</summary>
## </param>
#
template(`qbittorrent_role_template',`
	gen_require(`
		attribute_role qbittorrent_roles;
		attribute qbittorrent_domain;
		attribute qbittorrent_script_domain;
	')

	##############################
	#
	# Declarations
	#

	roleattribute $2 qbittorrent_roles;

	type $1_qbittorrent_t, qbittorrent_domain;
	application_domain($1_qbittorrent_t, qbittorrent_exec_t)
	ubac_constrained($1_qbittorrent_t)

	type $1_qbittorrent_script_t, qbittorrent_script_domain;
	application_domain($1_qbittorrent_script_t, qbittorrent_script_exec_t)
	ubac_constrained($1_qbittorrent_script_t)

	role $2 types { $1_qbittorrent_t $1_qbittorrent_script_t };

	##############################
	#
	# Local policy
	#

	domtrans_pattern($3, qbittorrent_script_exec_t, $1_qbittorrent_script_t)
	domtrans_pattern($1_qbittorrent_script_t, qbittorrent_exec_t, $1_qbittorrent_t)
	allow $1_qbittorrent_script_t $1_qbittorrent_t:process2 { nosuid_transition nnp_transition };
	qbittorrent_filetrans_home_content($3)

	# screenshare access
	allow $1_qbittorrent_t $3:unix_stream_socket { connectto rw_socket_perms };

	kernel_read_system_state($1_qbittorrent_t)
	pulseaudio_tmpfs_content($1_qbittorrent_t)

	optional_policy(`
		gen_require(`
			type user_tmpfs_t;
		')
		xserver_user_x_domain_template($1_qbittorrent, $1_qbittorrent_t, user_tmpfs_t)
	')

	# Trivalent-Flatpak integration
	# uncomment this once new flatpak policy is in use
	# optional_policy(`
	# 	flatpak_role_template($1_qbittorrent, $2, $1_qbittorrent_t, $1_t)
	# 	allow $1_qbittorrent_t $1_qbittorrent_flatpak_t:process2 { nnp_transition nosuid_transition };
	# 	write_fifo_files_pattern($1_qbittorrent_flatpak_t, $1_qbittorrent_script_t, $1_qbittorrent_script_t)
	# 	# write_fifo_files_pattern($3, $1_qbittorrent_script_t, $1_qbittorrent_script_t)
	# ')
')


########################################
## <summary>
##	Create qbittorrent directory in the user home directory
##	with an correct label.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
#
interface(`qbittorrent_filetrans_home_content',`
	gen_require(`
		type qbittorrent_home_t;
	')

	optional_policy(`
		gnome_config_filetrans($1, qbittorrent_home_t, dir, "qbittorrent")
		gnome_cache_filetrans($1, qbittorrent_home_t, dir, "qbittorrent")
	')
')