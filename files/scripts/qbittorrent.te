policy_module(qbittorrent, 1.0.0)

# SPDX-FileCopyrightText 2025 The Secureblue Authors
#
# SPDX-License-Identifier: Apache-2.0 OR MIT

########################################
#
# Declarations
#

## <desc>
## <p>
## Allow chromium to read/write/map v4l devices
## </p>
## <p>
## Needed for camera access
## </p>
## </desc>
gen_tunable(qbittorrent_rwmap_video_dev, true)

attribute_role qbittorrent_roles;

attribute qbittorrent_domain;
attribute qbittorrent_script_domain;

type qbittorrent_exec_t;
application_executable_file(qbittorrent_exec_t)

type qbittorrent_home_t;
userdom_user_home_content(qbittorrent_home_t)

type qbittorrent_script_exec_t;
application_executable_file(qbittorrent_script_exec_t)


##############################
#
# Local policy
#

gen_require(`
	attribute userdomain;
	class dbus acquire_svc;
	type audio_home_t;
	type chrome_sandbox_home_t;
	type device_t;
	type dosfs_t;
	type fonts_cache_t;
	type http_port_t;
	type http_cache_port_t;
	type howl_port_t;
	type ld_so_cache_t;
	type null_device_t;
	type root_t;
	type pki_ca_port_t;
	type nsfs_t;
	type tmp_t;
	type tmpfs_t;
	type user_home_t;
	type xserver_misc_device_t;
')

qbittorrent_filetrans_home_content(userdomain)
qbittorrent_filetrans_home_content(qbittorrent_domain)
qbittorrent_filetrans_home_content(qbittorrent_script_domain)

# internal
allow qbittorrent_domain self:process { dyntransition transition execmem getcap getsched ptrace setcap setrlimit setsched sigkill signal signull };
allow qbittorrent_domain self:dir { manage_dir_perms };
allow qbittorrent_domain self:file { manage_file_perms execute map };
allow qbittorrent_domain self:lnk_file { manage_lnk_file_perms };
allow qbittorrent_domain self:fifo_file rw_fifo_file_perms;
allow qbittorrent_domain self:sem create_sem_perms;
allow qbittorrent_domain self:netlink_kobject_uevent_socket client_stream_socket_perms;
allow qbittorrent_domain self:user_namespace create;
allow qbittorrent_domain self:unix_stream_socket { connectto rw_socket_perms };
allow qbittorrent_domain self:cap_userns { sys_admin sys_chroot sys_ptrace net_admin setpcap };
allow qbittorrent_domain self:capability { dac_read_search sys_admin sys_chroot sys_ptrace };
allow qbittorrent_domain self:fifo_file { manage_fifo_file_perms relabelfrom relabelto };
allow qbittorrent_domain self:dir rw_dir_perms;
allow qbittorrent_domain self:socket_class_set create_socket_perms;
allow qbittorrent_domain self:tcp_socket { accept listen };
allow qbittorrent_domain qbittorrent_exec_t:file execute_no_trans;
allow qbittorrent_domain chrome_sandbox_home_t:dir { manage_dir_perms };
allow qbittorrent_domain chrome_sandbox_home_t:file { manage_file_perms execute map };
allow qbittorrent_domain chrome_sandbox_home_t:lnk_file { manage_lnk_file_perms };
allow qbittorrent_domain qbittorrent_home_t:dir { manage_dir_perms };
allow qbittorrent_domain qbittorrent_home_t:file { manage_file_perms execute map };
allow qbittorrent_domain qbittorrent_home_t:lnk_file { manage_lnk_file_perms };
allow qbittorrent_domain self:netlink_route_socket { nlmsg_read nlmsg_write };

# not covered by interfaces
allow qbittorrent_domain fonts_cache_t:dir mounton;
allow qbittorrent_domain howl_port_t:udp_socket name_bind;
allow qbittorrent_domain http_port_t:tcp_socket { name_connect };
allow qbittorrent_domain http_cache_port_t:tcp_socket { name_connect };
allow qbittorrent_domain pki_ca_port_t:tcp_socket name_connect;
allow qbittorrent_domain root_t:dir mounton;
allow qbittorrent_domain tmp_t:lnk_file { create unlink };
allow qbittorrent_domain tmp_t:sock_file { create unlink };
allow qbittorrent_domain tmp_t:dir mounton;
allow qbittorrent_domain tmpfs_t:file mounton;
allow qbittorrent_domain tmpfs_t:dir { create };

# required for qbittorrent to be able to detect whether it's the default browser
allow qbittorrent_domain qbittorrent_script_exec_t:file { execute getattr read execute_no_trans ioctl open };

# homedir access
allow qbittorrent_domain user_home_t:dir { manage_dir_perms };
allow qbittorrent_domain user_home_t:file { manage_file_perms };
allow qbittorrent_domain user_home_t:lnk_file { manage_lnk_file_perms };
allow qbittorrent_domain audio_home_t:dir { manage_dir_perms };
allow qbittorrent_domain audio_home_t:file { manage_file_perms };
allow qbittorrent_domain audio_home_t:lnk_file { manage_lnk_file_perms };

optional_policy(`
	gen_require(`
		attribute file_manager_type;
	')

	# required for qbittorrent/FM clipboard sharing
	allow qbittorrent_domain file_manager_type:fifo_file write;
')

# allow qbittorrent to interface with flatpaks (necessary for keepassxc extension, for example)
# uncomment this once new flatpak policy is in use
# optional_policy(`
# 	flatpak_read_apps(qbittorrent_domain)
# 	flatpak_exec_apps(qbittorrent_domain)
# ')
allow qbittorrent_domain data_home_t:file { execute execute_no_trans };

# allow qbittorrent to own its mpris daemon
dbus_connect_session_bus(qbittorrent_domain)

# xwayland/nvidia
xserver_exec(qbittorrent_domain)
dev_rw_xserver_misc(qbittorrent_domain)
dev_map_xserver_misc(qbittorrent_domain)
allow qbittorrent_domain xserver_misc_device_t:chr_file { getattr ioctl map open read write };
xserver_stream_connect_xdm(qbittorrent_domain)
xserver_stream_connect(qbittorrent_domain)

files_list_home(qbittorrent_domain)
files_search_home(qbittorrent_domain)
files_read_usr_files(qbittorrent_domain)
files_read_etc_files(qbittorrent_domain)
files_read_etc_runtime_files(qbittorrent_domain)
files_watch_etc_dirs(qbittorrent_domain)
files_getattr_all_dirs(qbittorrent_domain)
files_watch_root_dirs(qbittorrent_domain)
files_read_var_lib_files(qbittorrent_domain)
files_rw_generic_tmp_dir(qbittorrent_domain)
files_manage_generic_tmp_files(qbittorrent_domain)
files_manage_generic_tmp_dirs(qbittorrent_domain)
files_rw_generic_tmp_sockets(qbittorrent_domain)
files_rw_tmp_file_leaks(qbittorrent_domain)
files_map_generic_tmp_files(qbittorrent_domain)

# memory pressure
kernel_read_psi(qbittorrent_domain)
kernel_read_kernel_sysctls(qbittorrent_domain)
kernel_read_fs_sysctls(qbittorrent_domain)

# required to connect to wayland
dbus_system_bus_client(qbittorrent_domain)
dbus_session_bus_client(qbittorrent_domain)

dbus_write_session_tmp_sock_files(qbittorrent_domain)
devicekit_dbus_chat_disk(qbittorrent_domain)
devicekit_dbus_chat_power(qbittorrent_domain)
systemd_dbus_chat_hostnamed(qbittorrent_domain)

fs_rw_inherited_tmpfs_files(qbittorrent_domain)
fs_getattr_xattr_fs(qbittorrent_domain)
fs_getattr_tmpfs(qbittorrent_domain)
fs_manage_tmpfs_files(qbittorrent_domain)
fs_map_tmpfs_files(qbittorrent_domain)
fs_search_cgroup_dirs(qbittorrent_domain)
fs_associate_proc(qbittorrent_domain)
fs_unmount_tmpfs(qbittorrent_domain)
fs_mount_tmpfs(qbittorrent_domain)
fs_manage_tmpfs_symlinks(qbittorrent_domain)
fs_all_mount_fs_perms_xattr_fs(qbittorrent_domain)
fs_mounton_tmpfs(qbittorrent_domain)

miscfiles_read_all_certs(qbittorrent_domain)
miscfiles_map_generic_certs(qbittorrent_domain)
miscfiles_read_localization(qbittorrent_domain)
miscfiles_watch_localization_dirs(qbittorrent_domain)
miscfiles_read_hwdata(qbittorrent_domain)

alsa_read_rw_config(qbittorrent_domain)
pulseaudio_stream_connect(qbittorrent_domain)
pulseaudio_read_home_files(qbittorrent_domain)
cups_read_config(qbittorrent_domain)
cups_stream_connect(qbittorrent_domain)

dev_read_sysfs(qbittorrent_domain)
dev_rw_dma_dev(qbittorrent_domain)
dev_rw_dri(qbittorrent_domain)
dev_rw_generic_usb_dev(qbittorrent_domain)
dev_read_sound(qbittorrent_domain)
dev_write_sound(qbittorrent_domain)
dev_read_urand(qbittorrent_domain)
dev_read_rand(qbittorrent_domain)

tunable_policy(`qbittorrent_rwmap_video_dev', `
	dev_read_video_dev(qbittorrent_domain)
	dev_write_video_dev(qbittorrent_domain)
	dev_map_video_dev(qbittorrent_domain)
')

udev_read_pid_files(qbittorrent_domain)
term_mount_pty_fs(qbittorrent_domain)

gnome_search_gconf_data_dir(qbittorrent_domain)
gnome_manage_cache_home_dir(qbittorrent_domain)
gnome_manage_generic_cache_files(qbittorrent_domain)
gnome_manage_generic_cache_sockets(qbittorrent_domain)
gnome_map_generic_cache_files(qbittorrent_domain)
gnome_manage_home_config(qbittorrent_domain)
gnome_exec_config_home_files(qbittorrent_domain)
gnome_manage_home_config_dirs(qbittorrent_domain)
gnome_manage_data(qbittorrent_domain)
gnome_manage_generic_home_files(qbittorrent_domain)
gnome_manage_generic_home_dirs(qbittorrent_domain)
gnome_map_generic_data_home_files(qbittorrent_domain)
gnome_manage_gstreamer_home_files(qbittorrent_domain)
gnome_dbus_chat_gconfdefault(qbittorrent_domain)
gnome_dbus_chat_gkeyringd(qbittorrent_domain)

userdom_manage_user_tmp_sockets(qbittorrent_domain)
userdom_manage_user_tmp_files(qbittorrent_domain)
userdom_map_tmp_files(qbittorrent_domain)
userdom_manage_tmpfs_files(qbittorrent_domain)
userdom_read_inherited_user_tmp_files(qbittorrent_domain)
userdom_manage_home_certs(qbittorrent_domain)
userdom_use_user_terminals(qbittorrent_domain)
userdom_list_user_home_dirs(qbittorrent_domain)

logging_write_journal_files(qbittorrent_domain)
logging_write_syslog_pid_socket(qbittorrent_domain)

auth_read_passwd_file(qbittorrent_domain)

# needed to be able to xdg-open, which is bin_t
corecmd_exec_bin(qbittorrent_domain)

pcscd_stream_connect(qbittorrent_domain)
xserver_use_user_fonts(qbittorrent_domain)
xserver_map_user_fonts(qbittorrent_domain)

systemd_dbus_chat_hostnamed(qbittorrent_domain)
systemd_resolved_watch_pid_dirs(qbittorrent_domain)
init_search_pid_dirs(qbittorrent_domain)
init_read_state(qbittorrent_domain)

corenet_tcp_connect_all_unreserved_ports(qbittorrent_domain)
corenet_tcp_connect_generic_port(qbittorrent_domain)
corenet_tcp_connect_ftp_port(qbittorrent_domain)
corenet_tcp_connect_http_port(qbittorrent_domain)
corenet_tcp_connect_ipp_port(qbittorrent_domain)
corenet_tcp_bind_generic_node(qbittorrent_domain)
corenet_udp_bind_generic_node(qbittorrent_domain)
corenet_udp_bind_all_unreserved_ports(qbittorrent_domain)
sysnet_read_config(qbittorrent_domain)
sysnet_dns_name_resolve(qbittorrent_domain)
networkmanager_dbus_chat(qbittorrent_domain)

storage_getattr_fixed_disk_dev(qbittorrent_domain)

optional_policy(`
	bluetooth_dbus_chat(qbittorrent_domain)
')

allow qbittorrent_script_domain qbittorrent_domain:dir { getattr search };
allow qbittorrent_script_domain qbittorrent_domain:file { open read };
allow qbittorrent_script_domain self:dir { add_entry_dir_perms };
allow qbittorrent_script_domain self:file { create };
allow qbittorrent_script_domain self:user_namespace create;
allow qbittorrent_script_domain self:cap_userns { sys_ptrace sys_admin setpcap };
allow qbittorrent_script_domain self:process { ptrace setcap setsched };
allow qbittorrent_script_domain user_home_t:dir { search };
allow qbittorrent_script_domain chrome_sandbox_home_t:dir { manage_dir_perms };
allow qbittorrent_script_domain chrome_sandbox_home_t:file { manage_file_perms };
allow qbittorrent_script_domain chrome_sandbox_home_t:lnk_file read;
allow qbittorrent_script_domain qbittorrent_home_t:dir { manage_dir_perms };
allow qbittorrent_script_domain qbittorrent_home_t:file { manage_file_perms map };
allow qbittorrent_script_domain qbittorrent_home_t:lnk_file { manage_lnk_file_perms };
allow qbittorrent_script_domain nsfs_t:file getattr;
allow qbittorrent_script_domain ld_so_cache_t:file mounton;
allow qbittorrent_script_domain root_t:dir mounton;
allow qbittorrent_script_domain tmp_t:dir mounton;
allow qbittorrent_script_domain tmp_t:sock_file getattr;
allow qbittorrent_script_domain tmpfs_t:dir { create };
allow qbittorrent_script_domain device_t:filesystem remount;
allow qbittorrent_script_domain dosfs_t:filesystem remount;
allow qbittorrent_script_domain null_device_t:chr_file mounton;

# xwayland/nvidia
xserver_exec(qbittorrent_script_domain)
dev_rw_xserver_misc(qbittorrent_script_domain)
dev_map_xserver_misc(qbittorrent_script_domain)
allow qbittorrent_script_domain xserver_misc_device_t:chr_file { getattr ioctl map open read write };

domain_dontaudit_search_all_domains_state(qbittorrent_script_domain)
fs_mounton_tmpfs(qbittorrent_script_domain)
fs_unmount_tmpfs(qbittorrent_script_domain)
fs_mount_tmpfs(qbittorrent_script_domain)
gnome_manage_data(qbittorrent_script_domain)
gnome_manage_home_config(qbittorrent_script_domain)
gnome_manage_home_config_dirs(qbittorrent_script_domain)
gnome_manage_cache_home_dir(qbittorrent_script_domain)
gnome_manage_generic_cache_files(qbittorrent_script_domain)
gnome_manage_generic_cache_sockets(qbittorrent_script_domain)
gnome_map_generic_cache_files(qbittorrent_script_domain)
corecmd_exec_shell(qbittorrent_script_domain)
corecmd_exec_bin(qbittorrent_script_domain)
files_getattr_all_dirs(qbittorrent_script_domain)
userdom_list_user_home_dirs(qbittorrent_script_domain)
kernel_list_proc(qbittorrent_script_domain)
kernel_read_proc_files(qbittorrent_script_domain)
kernel_getattr_proc_files(qbittorrent_script_domain)
kernel_getattr_proc(qbittorrent_script_domain)
seutil_exec_setfiles(qbittorrent_script_domain)
seutil_manage_file_contexts(qbittorrent_script_domain)
userdom_use_inherited_user_terminals(qbittorrent_script_domain)
fs_all_mount_fs_perms_xattr_fs(qbittorrent_script_domain)

optional_policy(`
	gen_require(`
		type unconfined_t;
		role unconfined_r;
	')

	qbittorrent_role_template(unconfined, unconfined_r, unconfined_t)
')

optional_policy(`
	gen_require(`
		type sysadm_t;
		role sysadm_r;
	')

	qbittorrent_role_template(sysadm, sysadm_r, sysadm_t)
')

optional_policy(`
	gen_require(`
		type staff_t;
		role staff_r;
	')

	qbittorrent_role_template(staff, staff_r, staff_t)
')

optional_policy(`
	gen_require(`
		type user_t;
		role user_r;
	')

	qbittorrent_role_template(user, user_r, user_t)
')