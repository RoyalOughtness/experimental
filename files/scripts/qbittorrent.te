policy_module(qbittorrent, 1.0.0)

attribute_role qbittorrent_roles;
roleattribute object_r qbittorrent_roles;

type qbittorrent_t;
type qbittorrent_exec_t;
domain_type(qbittorrent_t, qbittorrent_exec_t)
application_domain(qbittorrent_t, qbittorrent_exec_t)

role qbittorrent_roles types qbittorrent_t;

optional_policy(`
	gen_require(`
		type init_t;
		role unconfined_r;
	')

	qbittorrent_run(init_t, system_r)
')

gen_require(`
	type config_home_t;
  type net_conf_t;
  type init_t;
')

allow qbittorrent_t self:unix_dgram_socket { ioctl write create getopt setopt };
allow qbittorrent_t self:netlink_route_socket { write read setopt bind create nlmsg_read getattr ioctl };
allow qbittorrent_t self:tcp_socket { write setopt accept getattr read getopt bind create listen connect };
allow qbittorrent_t self:udp_socket { setopt read bind write create getattr connect ioctl };
allow qbittorrent_t http_cache_port_t:tcp_socket { name_bind };
allow qbittorrent_t cache_home_t:dir search_dir_perms;
allow qbittorrent_t user_home_dir_t:dir search_dir_perms;

allow init_t qbittorrent_t:process { siginh };

gnome_manage_home_config(qbittorrent_t)
gnome_manage_home_config_dirs(qbittorrent_t)
gnome_manage_data(qbittorrent_t)
files_manage_generic_tmp_dirs(qbittorrent_t)
container_manage_dirs(qbittorrent_t)
container_manage_files(qbittorrent_t)
dev_read_sysfs(qbittorrent_t)
corenet_tcp_bind_all_nodes(qbittorrent_t)
corenet_udp_bind_all_nodes(qbittorrent_t)
corenet_tcp_connect_all_ports(qbittorrent_t)
corenet_udp_bind_all_ports(qbittorrent_t)
manage_sock_files_pattern(qbittorrent_t, config_home_t, config_home_t)
miscfiles_read_all_certs(qbittorrent_t)
logging_write_syslog_pid_socket(qbittorrent_t)
init_rw_stream_sockets(qbittorrent_t)
init_search_pid_dirs(qbittorrent_t)
read_files_pattern(qbittorrent_t, net_conf_t, net_conf_t)
fs_getattr_xattr_fs(qbittorrent_t)
dev_read_sysfs(qbittorrent_t)
storage_getattr_fixed_disk_dev(qbittorrent_t)